FROM rust:1.85-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --locked --bin admin_panel-cli

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/debug/admin_panel-cli /app/admin_panel-cli
COPY assets ./assets
COPY config ./config
COPY data/sample.sqlite /seed/sample.sqlite
COPY scripts/dev/container.sh /app/start.sh
CMD ["bash", "/app/start.sh"]
